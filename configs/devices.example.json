{
  "devices": {
    "dut": {
      "type": "generic",
      "host": {"type": "local", "name": "bench-pc", "timeout": 10},
      "metadata": {"model": "my-board"},
      "channels": {
        "shell": {"type": "ssh", "host": "${DUT_HOST}", "username": "root", "timeout": 30},
        "api": {"type": "http", "base_url": "http://${DUT_HOST}:8080", "timeout": 5},
        "console": {"type": "serial", "port": "${DUT_SERIAL_PORT}", "baudrate": 115200, "timeout": 3},
        "files": {"type": "ftp", "host": "${DUT_HOST}", "username": "${DUT_FTP_USER}", "password": "${DUT_FTP_PASSWORD}"}
      }
    }
  }
}
